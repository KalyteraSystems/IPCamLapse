@page
@model IPCamLapse.Pages.Cameras.IndexModel
@{
    ViewData["Title"] = "Cameras";
}

<header class="page-header">
    <div class="page-header-copy">
        <span class="page-kicker">Sources / camera profiles</span>
        <h1 class="page-title">Cameras</h1>
        <p class="page-lede">Save a camera once, protect its credentials locally, and reuse it across capture sessions.</p>
    </div>
    <div class="page-actions">
        <a asp-page="/Cameras/Edit" class="btn btn-primary btn-lg"><i class="bi bi-plus-square me-2" aria-hidden="true"></i>Add camera</a>
    </div>
</header>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-4">
    @foreach (var profile in Model.Profiles)
    {
        <div class="col-xl-4 col-md-6">
            <article class="card h-100 shadow-sm camera-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div class="camera-icon"><i class="bi @(profile.IsDemo ? "bi-stars" : "bi-camera-video")" aria-hidden="true"></i></div>
                        <div>
                            @if (profile.IsDemo)
                            {
                                <span class="badge bg-info text-dark">Built-in demo</span>
                            }
                            else if (Model.ProfilesInUse.Contains(profile.Id))
                            {
                                <span class="badge bg-light text-dark">In use</span>
                            }
                        </div>
                    </div>
                    <span class="section-kicker">@(profile.IsDemo ? "Simulated source" : "Saved profile")</span>
                    <h2 class="h4">@profile.Name</h2>
                    <p class="small text-muted text-break mb-2">@(profile.IsDemo ? "Simulated daylight scene" : profile.Url)</p>
                    @if (!profile.IsDemo)
                    {
                        <p class="small mb-0"><i class="bi bi-person me-1"></i>@(profile.Username ?? "No username")</p>
                    }
                </div>
                <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                    <a asp-page="/Sessions/Create" class="btn btn-sm btn-outline-primary flex-fill">Use camera <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary camera-test-button"
                            data-profile-id="@profile.Id">
                        <i class="bi bi-wifi me-1" aria-hidden="true"></i>Test connection
                    </button>
                    @if (!profile.IsDemo)
                    {
                        <a asp-page="/Cameras/Edit" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@profile.Id" onsubmit="return confirm('Delete this camera profile?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger" @(Model.ProfilesInUse.Contains(profile.Id) ? "disabled" : null) aria-label="Delete @profile.Name">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                    <div class="camera-test-status small w-100"
                         role="status"
                         aria-live="polite"></div>
                </div>
            </article>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.camera-test-button').forEach(button => {
            button.addEventListener('click', async () => {
                const card = button.closest('.camera-card');
                const status = card.querySelector('.camera-test-status');
                const profileId = button.dataset.profileId;
                button.disabled = true;
                card.setAttribute('aria-busy', 'true');
                status.className = 'camera-test-status small w-100 text-muted';
                status.textContent = 'Testing camera connection…';

                try {
                    const response = await window.ipCamLapseFetch('/api/camera/test', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ profileId })
                    });
                    const data = await response.json();
                    const duration = Number.isFinite(data.durationMs)
                        ? ` · ${Math.round(data.durationMs)} ms`
                        : '';
                    if (!response.ok)
                        throw new Error(`${data.message || 'Connection failed'}${duration}`);
                    status.className = 'camera-test-status small w-100 text-success';
                    status.textContent = `Connected${duration}`;
                } catch (error) {
                    status.className = 'camera-test-status small w-100 text-danger';
                    status.textContent = error.message || 'Connection failed';
                } finally {
                    button.disabled = false;
                    card.removeAttribute('aria-busy');
                }
            });
        });
    </script>
}
