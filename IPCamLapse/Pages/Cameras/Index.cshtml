@page
@model IPCamLapse.Pages.Cameras.IndexModel
@{
    ViewData["Title"] = "Cameras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Cameras</h1>
        <p class="text-muted mb-0">Save connection details once and reuse them in any session.</p>
    </div>
    <a asp-page="/Cameras/Edit" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add camera</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-4">
    @foreach (var profile in Model.Profiles)
    {
        <div class="col-xl-4 col-md-6">
            <article class="card h-100 shadow-sm camera-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div class="camera-icon"><i class="bi @(profile.IsDemo ? "bi-stars" : "bi-camera")"></i></div>
                        <div>
                            @if (profile.IsDemo)
                            {
                                <span class="badge bg-info text-dark">Built in</span>
                            }
                            else if (Model.ProfilesInUse.Contains(profile.Id))
                            {
                                <span class="badge bg-light text-dark">In use</span>
                            }
                        </div>
                    </div>
                    <h2 class="h5">@profile.Name</h2>
                    <p class="small text-muted text-break mb-2">@(profile.IsDemo ? "Simulated daylight scene" : profile.Url)</p>
                    @if (!profile.IsDemo)
                    {
                        <p class="small mb-0"><i class="bi bi-person me-1"></i>@(profile.Username ?? "No username")</p>
                    }
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-page="/Sessions/Create" class="btn btn-sm btn-outline-primary flex-fill">New session</a>
                    @if (!profile.IsDemo)
                    {
                        <a asp-page="/Cameras/Edit" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@profile.Id" onsubmit="return confirm('Delete this camera profile?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger" @(Model.ProfilesInUse.Contains(profile.Id) ? "disabled" : null) aria-label="Delete @profile.Name">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </article>
        </div>
    }
</div>
