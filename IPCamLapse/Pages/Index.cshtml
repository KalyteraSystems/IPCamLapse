@page
@model IndexModel
@using IPCamLapse.Models
@{
    ViewData["Title"] = "Sessions";
    var storagePercent = Model.Storage.MaxBytes > 0
        ? Math.Clamp(Model.Storage.UsedBytes * 100d / Model.Storage.MaxBytes, 0, 100)
        : 0;
    var storagePercentValue = storagePercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
}

<header class="page-header">
    <div class="page-header-copy">
        <span class="page-kicker">Capture operations / sessions</span>
        <h1 class="page-title">Capture sessions</h1>
        <p class="page-lede">Monitor every time-lapse from first frame to final render.</p>
    </div>
    <div class="page-actions">
        <a asp-page="/Sessions/Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-square me-2" aria-hidden="true"></i>New session
        </a>
    </div>
</header>

@if (!Model.Health.Healthy)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
        <span><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>System check needs attention.</span>
        <a asp-page="/System" class="alert-link text-nowrap">Review checks <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
    </div>
}

<div class="storage-strip">
    <div class="storage-strip-label"><i class="bi bi-device-hdd" aria-hidden="true"></i>Storage</div>
    <div class="progress">
        <div class="progress-bar @(Model.Storage.IsLow ? "bg-danger" : "")"
             style="width: @storagePercentValue%"
             role="progressbar"
             aria-label="Storage used"
             aria-valuenow="@storagePercentValue"
             aria-valuemin="0"
             aria-valuemax="100"></div>
    </div>
    <a asp-page="/Settings" class="storage-strip-value">@FormatBytes(Model.Storage.UsedBytes) / @FormatBytes(Model.Storage.MaxBytes)</a>
</div>

@if (!Model.Sessions.Any())
{
    <section class="empty-state">
        <div class="empty-state-inner">
            <span class="empty-state-icon"><i class="bi bi-camera-video" aria-hidden="true"></i></span>
            <span class="section-kicker">Ready when you are</span>
            <h2>No capture sessions yet</h2>
            <p>Use the built-in demo camera to test capture, scheduling, frame review, and video rendering without any hardware.</p>
            <a asp-page="/Sessions/Create" class="btn btn-primary btn-lg mt-2">Start with demo camera <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a>
        </div>
    </section>
}
else
{
    <div class="row g-4" id="sessions-grid">
        @foreach (var session in Model.Sessions)
        {
            var progress = session.GetProgressPercent(DateTime.UtcNow);
            var progressValue = progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            <div class="col-xl-4 col-lg-6" id="session-card-@session.Id">
                <article class="card h-100 shadow-sm session-card @GetStatusCardClass(session.Status)">
                    <div class="card-header d-flex justify-content-between align-items-center gap-3">
                        <div class="min-w-0">
                            <span class="section-kicker mb-1">Session / @session.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            <h2 class="h6 mb-0 text-truncate">@session.Name</h2>
                        </div>
                        <span class="badge @GetStatusBadgeClass(session.Status)" id="status-@session.Id">@session.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Progress</span>
                            <span class="progress-text-@session.Id">@progress.ToString("F1")%</span>
                        </div>
                        <div class="progress mb-3" style="height: 7px;">
                            <div class="progress-bar progress-bar-@session.Id @(session.Status == SessionStatus.Capturing ? "progress-bar-animated progress-bar-striped" : "")"
                                 style="width: @progressValue%"
                                 role="progressbar"
                                 aria-valuenow="@progressValue"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>

                        <div class="row g-2 mb-3 text-center">
                            <div class="col-4">
                                <div class="stat-box rounded bg-light p-2">
                                    <strong class="d-block frame-count-@session.Id">@session.CapturedFrameCount</strong>
                                    <small class="text-muted">Frames</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-box rounded bg-light p-2">
                                    <strong class="d-block">@FormatInterval(session.Configuration.CaptureIntervalSeconds)</strong>
                                    <small class="text-muted">Interval</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-box rounded bg-light p-2">
                                    <strong class="d-block @(session.ConsecutiveCaptureFailures > 0 ? "text-danger" : "")">@session.ConsecutiveCaptureFailures</strong>
                                    <small class="text-muted">Failures</small>
                                </div>
                            </div>
                        </div>

                        @if (session.Status == SessionStatus.Scheduled && session.ScheduledFor.HasValue)
                        {
                            <p class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i>@session.ScheduledFor.Value.ToLocalTime().ToString("MMM d, HH:mm")</p>
                        }
                        else if (session.LastCaptureAt.HasValue)
                        {
                            <p class="small text-muted mb-2"><i class="bi bi-clock me-1"></i>@FormatTimeAgo(session.LastCaptureAt.Value)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.LastCaptureError))
                        {
                            <p class="small text-danger text-truncate mb-0" title="@session.LastCaptureError">@session.LastCaptureError</p>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-page="/Sessions/Details" asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary flex-fill">Open session <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
                            @if (session.Status is SessionStatus.Ready or SessionStatus.Paused or SessionStatus.Failed)
                            {
                                <button type="button" class="btn btn-sm btn-success" onclick="startSession('@session.Id', event)" aria-label="Start @session.Name">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                            }
                            @if (session.Status is SessionStatus.Capturing or SessionStatus.Scheduled)
                            {
                                <button type="button" class="btn btn-sm btn-warning" onclick="pauseSession('@session.Id', event)" aria-label="Pause @session.Name">
                                    <i class="bi bi-pause-fill"></i>
                                </button>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/progressHub')
            .withAutomaticReconnect()
            .build();

        connection.on('ProgressUpdate', data => {
            const frame = document.querySelector(`.frame-count-${data.sessionId}`);
            const bar = document.querySelector(`.progress-bar-${data.sessionId}`);
            const text = document.querySelector(`.progress-text-${data.sessionId}`);
            if (frame) frame.textContent = data.frameCount;
            if (bar) {
                bar.style.width = data.progressPercent.toFixed(1) + '%';
                bar.setAttribute('aria-valuenow', data.progressPercent.toFixed(1));
            }
            if (text) text.textContent = data.progressPercent.toFixed(1) + '%';
        });
        connection.on('StatusChanged', () => location.reload());
        connection.on('SessionCompleted', () => location.reload());

        async function connect() {
            try {
                await connection.start();
                @foreach (var session in Model.Sessions.Where(session => session.Status is SessionStatus.Capturing or SessionStatus.Scheduled or SessionStatus.Rendering))
                {
                    <text>await connection.invoke('JoinSession', '@session.Id');</text>
                }
            } catch { }
        }

        async function sessionAction(id, action, event) {
            const button = event.target.closest('button');
            button.disabled = true;
            try {
                const response = await window.ipCamLapseFetch(`/api/sessions/${id}/${action}`, { method: 'POST' });
                if (!response.ok) {
                    const data = await response.json();
                    throw new Error(data.message || 'Action failed');
                }
                location.reload();
            } catch (error) {
                window.ipCamLapseNotify(error.message || 'Action failed');
                button.disabled = false;
            }
        }

        const startSession = (id, event) => sessionAction(id, 'start', event);
        const pauseSession = (id, event) => sessionAction(id, 'pause', event);
        connect();
    </script>
}

@functions {
    string GetStatusBadgeClass(SessionStatus status) => status switch
    {
        SessionStatus.Capturing => "bg-success",
        SessionStatus.Paused => "bg-warning text-dark",
        SessionStatus.Completed => "bg-primary",
        SessionStatus.Failed => "bg-danger",
        SessionStatus.Cancelled => "bg-secondary",
        SessionStatus.Scheduled => "bg-info text-dark",
        SessionStatus.Rendering => "bg-info text-dark",
        _ => "bg-light text-dark"
    };

    string GetStatusCardClass(SessionStatus status) => status switch
    {
        SessionStatus.Capturing => "border-success",
        SessionStatus.Failed => "border-danger",
        _ => string.Empty
    };

    string FormatInterval(int seconds) => seconds switch
    {
        < 60 => $"{seconds}s",
        < 3600 => $"{seconds / 60}m",
        _ => $"{seconds / 3600}h"
    };

    string FormatTimeAgo(DateTime value)
    {
        var difference = DateTime.UtcNow - value;
        if (difference.TotalSeconds < 60) return $"{Math.Max(0, (int)difference.TotalSeconds)}s ago";
        if (difference.TotalMinutes < 60) return $"{(int)difference.TotalMinutes}m ago";
        if (difference.TotalHours < 24) return $"{(int)difference.TotalHours}h ago";
        return $"{(int)difference.TotalDays}d ago";
    }

    string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024) return $"{bytes / 1024d / 1024d / 1024d:F1} GB";
        return $"{bytes / 1024d / 1024d:F1} MB";
    }
}
