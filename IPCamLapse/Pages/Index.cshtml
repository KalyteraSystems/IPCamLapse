@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">
            <i class="bi bi-camera-video text-primary me-2"></i>
            IPCamLapse Dashboard
        </h1>
        <p class="text-muted mb-0">Manage your IP camera timelapse sessions</p>
    </div>
    <a asp-page="/Sessions/Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>New Session
    </a>
</div>

@if (!Model.Sessions.Any())
{
    <div class="text-center py-5">
        <div class="empty-state">
            <i class="bi bi-camera-video display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">No sessions yet</h3>
            <p class="text-muted">Create your first timelapse session to get started</p>
            <a asp-page="/Sessions/Create" class="btn btn-primary btn-lg mt-2">
                <i class="bi bi-plus-circle me-2"></i>Create First Session
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4" id="sessions-grid">
        @foreach (var session in Model.Sessions)
        {
            <div class="col-xl-4 col-lg-6" id="session-card-@session.Id">
                <div class="card h-100 shadow-sm session-card @GetStatusCardClass(session.Status)">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-semibold text-truncate me-2">@session.Name</h6>
                        <span class="badge @GetStatusBadgeClass(session.Status) flex-shrink-0">
                            @if (session.Status == IPCamLapse.Models.SessionStatus.Running)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @session.Status
                        </span>
                    </div>
                    <div class="card-body">
                        @if (session.Status == IPCamLapse.Models.SessionStatus.Running || session.Status == IPCamLapse.Models.SessionStatus.Paused)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Progress</small>
                                    <small class="fw-semibold progress-text-@session.Id">@session.ProgressPercent.ToString("F1")%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar progress-bar-@session.Id @(session.Status == IPCamLapse.Models.SessionStatus.Running ? "progress-bar-animated progress-bar-striped" : "")"
                                         style="width: @session.ProgressPercent.ToString("F1")%"></div>
                                </div>
                            </div>
                        }
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="stat-box text-center p-2 rounded bg-light">
                                    <div class="fw-bold fs-5 frame-count-@session.Id">@session.CapturedFrameCount</div>
                                    <small class="text-muted">Frames</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box text-center p-2 rounded bg-light">
                                    <div class="fw-bold fs-5">@FormatInterval(session.Configuration.CaptureIntervalSeconds)</div>
                                    <small class="text-muted">Interval</small>
                                </div>
                            </div>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-camera me-1"></i>
                            <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@session.Configuration.CameraUrl">
                                @TruncateUrl(session.Configuration.CameraUrl)
                            </span>
                        </div>
                        @if (session.LastCaptureAt.HasValue)
                        {
                            <div class="small text-muted">
                                <i class="bi bi-clock me-1"></i>
                                Last capture: @FormatTimeAgo(session.LastCaptureAt.Value)
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-page="/Sessions/Details" asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            @if (session.Status == IPCamLapse.Models.SessionStatus.Created || session.Status == IPCamLapse.Models.SessionStatus.Paused)
                            {
                                <button class="btn btn-sm btn-success" onclick="startSession('@session.Id', event)">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                            }
                            @if (session.Status == IPCamLapse.Models.SessionStatus.Running)
                            {
                                <button class="btn btn-sm btn-warning" onclick="stopSession('@session.Id', event)">
                                    <i class="bi bi-pause-fill"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/progressHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ProgressUpdate", (data) => {
            const frameEl = document.querySelector(`.frame-count-${data.sessionId}`);
            const progressBar = document.querySelector(`.progress-bar-${data.sessionId}`);
            const progressText = document.querySelector(`.progress-text-${data.sessionId}`);
            if (frameEl) frameEl.textContent = data.frameCount;
            if (progressBar) progressBar.style.width = data.progressPercent.toFixed(1) + '%';
            if (progressText) progressText.textContent = data.progressPercent.toFixed(1) + '%';
        });

        connection.on("SessionCompleted", () => location.reload());

        async function startConnection() {
            try {
                await connection.start();
                @foreach (var session in Model.Sessions.Where(s => s.Status == IPCamLapse.Models.SessionStatus.Running || s.Status == IPCamLapse.Models.SessionStatus.Paused))
                {
                    <text>await connection.invoke("JoinSession", "@session.Id");</text>
                }
            } catch (err) {
                console.error("SignalR error:", err);
            }
        }
        startConnection();

        async function startSession(id, event) {
            const btn = event.target.closest('button');
            btn.disabled = true;
            try {
                const r = await window.ipCamLapseFetch(`/api/sessions/${id}/start`, { method: 'POST' });
                if (r.ok) location.reload();
                else { const err = await r.json(); alert(err.message || 'Failed to start session'); }
            } catch { alert('Error starting session'); }
            finally { btn.disabled = false; }
        }

        async function stopSession(id, event) {
            const btn = event.target.closest('button');
            btn.disabled = true;
            try {
                const r = await window.ipCamLapseFetch(`/api/sessions/${id}/stop`, { method: 'POST' });
                if (r.ok) location.reload();
            } finally { btn.disabled = false; }
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(IPCamLapse.Models.SessionStatus status) => status switch
    {
        IPCamLapse.Models.SessionStatus.Running => "bg-success",
        IPCamLapse.Models.SessionStatus.Paused => "bg-warning text-dark",
        IPCamLapse.Models.SessionStatus.Completed => "bg-primary",
        IPCamLapse.Models.SessionStatus.Failed => "bg-danger",
        IPCamLapse.Models.SessionStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string GetStatusCardClass(IPCamLapse.Models.SessionStatus status) => status switch
    {
        IPCamLapse.Models.SessionStatus.Running => "border-success",
        IPCamLapse.Models.SessionStatus.Failed => "border-danger",
        _ => ""
    };

    string FormatInterval(int seconds)
    {
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m";
        return $"{seconds / 3600}h";
    }

    string TruncateUrl(string url)
    {
        try { var uri = new Uri(url); return uri.Host; }
        catch { return url.Length > 30 ? url[..30] + "..." : url; }
    }

    string FormatTimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        return $"{(int)diff.TotalHours}h ago";
    }
}
