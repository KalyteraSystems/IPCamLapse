@page
@model IPCamLapse.Pages.SystemModel
@{
    ViewData["Title"] = "System check";
}

<header class="page-header">
    <div class="page-header-copy">
        <span class="page-kicker">Operations / readiness</span>
        <h1 class="page-title">System check</h1>
        <p class="page-lede">Verify rendering, storage access, and available disk before a long capture begins.</p>
    </div>
    <div class="page-actions">
        <a asp-page="/System" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>Run again</a>
    </div>
</header>

<div class="system-summary mb-4">
    <i class="bi @(Model.Health.Healthy ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger")" aria-hidden="true"></i>
    <strong>@(Model.Health.Healthy ? "Ready to capture" : "Attention required")</strong>
    <span class="text-muted">@Model.Health.Checks.Count(check => check.Healthy) of @Model.Health.Checks.Count checks passed</span>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach (var check in Model.Health.Checks)
            {
                <div class="list-group-item p-4 d-flex align-items-start gap-3">
                    <span class="health-icon @(check.Healthy ? "healthy" : "unhealthy")">
                        <i class="bi @(check.Healthy ? "bi-check-lg" : "bi-exclamation-lg")"></i>
                    </span>
                    <div>
                        <h2 class="h6 mb-1">@check.Name</h2>
                        <p class="small text-muted text-break mb-0">@check.Detail</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.Health.Healthy)
{
    <div class="alert alert-warning">
        <strong>Capture may be limited.</strong> Camera frames can still be collected without FFmpeg, but a video cannot be rendered until FFmpeg is available.
    </div>
}

<a asp-page="/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to sessions</a>
