@page
@model IPCamLapse.Pages.Sessions.CreateModel
@{
    ViewData["Title"] = "New session";
}

<div class="mb-4">
    <h1 class="h2">New session</h1>
</div>

<form method="post" id="createForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Presets</h5>
        </div>
        <div class="card-body">
            <div class="row g-3" id="presets-grid">
                @foreach (var preset in Model.Presets)
                {
                    <div class="col-md-4 col-sm-6">
                        <button type="button" class="preset-card card h-100 w-100 border-2 cursor-pointer text-start"
                             onclick="applyPreset(@preset.CaptureIntervalSeconds, @preset.CaptureDurationSeconds, @preset.VideoTargetDurationSeconds, '@preset.Name', this)">
                            <div class="card-body p-3">
                                <h6 class="mb-2 fw-semibold">@preset.Name</h6>
                                <p class="small text-muted mb-0">@preset.Description</p>
                            </div>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Settings</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <label asp-for="Session.Name" class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                        <input asp-for="Session.Name" class="form-control form-control-lg" placeholder="Backyard garden" required />
                        <span asp-validation-for="Session.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Session.Configuration.CameraUrl" class="form-label fw-semibold">Snapshot URL <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-camera"></i></span>
                            <input asp-for="Session.Configuration.CameraUrl" class="form-control" 
                                   placeholder="http://192.168.1.100/snapshot.jpg" required />
                            <button type="button" class="btn btn-outline-secondary" onclick="testCamera()">
                                <i class="bi bi-wifi me-1"></i>Test
                            </button>
                        </div>
                        <span asp-validation-for="Session.Configuration.CameraUrl" class="text-danger small"></span>
                        <div id="camera-test-result" class="mt-2 d-none"></div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="Session.Configuration.Username" class="form-label fw-semibold">Username</label>
                            <input asp-for="Session.Configuration.Username" class="form-control" placeholder="Optional" />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Session.Configuration.Password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <input asp-for="Session.Configuration.Password" type="password" class="form-control" placeholder="Optional" id="passwordField" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()" aria-label="Show or hide password">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Session.Configuration.AllowInvalidCertificate" class="form-check-input" />
                        <label asp-for="Session.Configuration.AllowInvalidCertificate" class="form-check-label">
                            Ignore TLS certificate errors
                        </label>
                        <div class="form-text">Trusted cameras only.</div>
                    </div>

                    <hr />

                    <h6 class="fw-semibold mb-3"><i class="bi bi-stopwatch me-2"></i>Timing</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Session.Configuration.CaptureIntervalSeconds" class="form-label fw-semibold">Interval</label>
                            <div class="input-group">
                                <input asp-for="Session.Configuration.CaptureIntervalSeconds" type="number" class="form-control" min="5" max="86400" id="intervalInput" oninput="updateIntervalDisplay()" />
                                <span class="input-group-text">seconds</span>
                            </div>
                            <div class="form-text" id="intervalDisplay">Every 5 minutes</div>
                            <span asp-validation-for="Session.Configuration.CaptureIntervalSeconds" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Session.Configuration.CaptureDurationSeconds" class="form-label fw-semibold">Capture length</label>
                            <div class="input-group">
                                <input asp-for="Session.Configuration.CaptureDurationSeconds" type="number" class="form-control" min="60" id="durationInput" oninput="updateDurationDisplay()" />
                                <span class="input-group-text">seconds</span>
                            </div>
                            <div class="form-text" id="durationDisplay">1 day</div>
                            <span asp-validation-for="Session.Configuration.CaptureDurationSeconds" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Session.Configuration.VideoTargetDurationSeconds" class="form-label fw-semibold">Video length</label>
                            <div class="input-group">
                                <input asp-for="Session.Configuration.VideoTargetDurationSeconds" type="number" step="0.5" class="form-control" min="1" max="600" />
                                <span class="input-group-text">seconds</span>
                            </div>
                            <span asp-validation-for="Session.Configuration.VideoTargetDurationSeconds" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Frames</label>
                            <div class="form-control bg-light" id="frameEstimate">288 frames</div>
                            <div class="form-text" id="fpsEstimate">at ~9.6 fps</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-image me-2"></i>Preview</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadPreview()" aria-label="Refresh preview">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                </div>
                <div class="card-body p-2">
                    <div id="preview-container" class="text-center py-4 text-muted">
                        <i class="bi bi-camera display-4"></i>
                        <p class="small mt-2">No preview</p>
                    </div>
                    <img id="preview-img" src="" alt="Camera preview" class="img-fluid rounded d-none" style="max-height: 200px; object-fit: contain;" />
                </div>
            </div>
        </div>
    </div>

    <input asp-for="Session.Configuration.PresetName" type="hidden" id="presetNameInput" />

    <div class="mt-4 d-flex gap-3">
        <button type="submit" class="btn btn-primary btn-lg px-5">
            <i class="bi bi-check-circle me-2"></i>Create
        </button>
        <a asp-page="/Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-x-circle me-2"></i>Cancel
        </a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        let previewObjectUrl = null;

        function updateIntervalDisplay() {
            const val = parseInt(document.getElementById('intervalInput').value) || 0;
            const display = document.getElementById('intervalDisplay');
            display.textContent = formatSeconds(val);
            updateEstimates();
        }

        function updateDurationDisplay() {
            const val = parseInt(document.getElementById('durationInput').value) || 0;
            document.getElementById('durationDisplay').textContent = formatDuration(val);
            updateEstimates();
        }

        function updateEstimates() {
            const interval = parseInt(document.getElementById('intervalInput').value) || 1;
            const duration = parseInt(document.getElementById('durationInput').value) || 0;
            const videoDuration = parseFloat(document.querySelector('[name="Session.Configuration.VideoTargetDurationSeconds"]').value) || 30;
            const frames = Math.floor(duration / interval);
            const fps = frames / videoDuration;
            document.getElementById('frameEstimate').textContent = `${frames} frames`;
            document.getElementById('fpsEstimate').textContent = `at ~${fps.toFixed(1)} fps`;
        }

        function formatSeconds(s) {
            if (s < 60) return `Every ${s} seconds`;
            if (s < 3600) return `Every ${Math.floor(s/60)} minute${Math.floor(s/60)>1?'s':''}`;
            return `Every ${Math.floor(s/3600)} hour${Math.floor(s/3600)>1?'s':''}`;
        }

        function formatDuration(s) {
            if (s < 3600) return `${Math.floor(s/60)} minutes`;
            if (s < 86400) return `${Math.floor(s/3600)} hours`;
            if (s < 604800) return `${Math.floor(s/86400)} days`;
            if (s < 2592000) return `${Math.floor(s/604800)} weeks`;
            if (s < 31536000) return `${Math.floor(s/2592000)} months`;
            return `${Math.floor(s/31536000)} years`;
        }

        function applyPreset(interval, duration, videoDuration, name, card) {
            document.getElementById('intervalInput').value = interval;
            document.getElementById('durationInput').value = duration;
            document.querySelector('[name="Session.Configuration.VideoTargetDurationSeconds"]').value = videoDuration;
            document.getElementById('presetNameInput').value = name;
            updateIntervalDisplay();
            updateDurationDisplay();
            document.querySelectorAll('.preset-card').forEach(c => c.classList.remove('border-primary', 'bg-primary-subtle'));
            card.classList.add('border-primary', 'bg-primary-subtle');
        }

        async function testCamera() {
            const url = document.querySelector('[name="Session.Configuration.CameraUrl"]').value;
            const username = document.querySelector('[name="Session.Configuration.Username"]').value;
            const password = document.querySelector('[name="Session.Configuration.Password"]').value;
            const allowInvalidCertificate = document.querySelector('[name="Session.Configuration.AllowInvalidCertificate"]').checked;
            const resultDiv = document.getElementById('camera-test-result');
            if (!url) {
                resultDiv.className = 'mt-2 alert alert-warning';
                resultDiv.textContent = 'Enter a snapshot URL.';
                return;
            }

            resultDiv.className = 'mt-2 alert alert-info';
            resultDiv.textContent = 'Testing...';

            try {
                const r = await window.ipCamLapseFetch('/api/camera/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url, username, password, allowInvalidCertificate })
                });
                if (r.ok) {
                    resultDiv.className = 'mt-2 alert alert-success';
                    resultDiv.innerHTML = '<i class="bi bi-check-circle me-1"></i>Connected';
                    loadPreview();
                } else {
                    resultDiv.className = 'mt-2 alert alert-danger';
                    resultDiv.innerHTML = '<i class="bi bi-x-circle me-1"></i>Connection failed';
                }
            } catch {
                resultDiv.className = 'mt-2 alert alert-danger';
                resultDiv.innerHTML = '<i class="bi bi-x-circle me-1"></i>Connection failed';
            }
        }

        async function loadPreview() {
            const url = document.querySelector('[name="Session.Configuration.CameraUrl"]').value;
            const username = document.querySelector('[name="Session.Configuration.Username"]').value;
            const password = document.querySelector('[name="Session.Configuration.Password"]').value;
            const allowInvalidCertificate = document.querySelector('[name="Session.Configuration.AllowInvalidCertificate"]').checked;
            if (!url) return;

            try {
                const r = await window.ipCamLapseFetch('/api/camera/snapshot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url, username, password, allowInvalidCertificate })
                });
                if (r.ok) {
                    const blob = await r.blob();
                    const img = document.getElementById('preview-img');
                    if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
                    previewObjectUrl = URL.createObjectURL(blob);
                    img.src = previewObjectUrl;
                    img.classList.remove('d-none');
                    document.getElementById('preview-container').classList.add('d-none');
                }
            } catch { }
        }

        function togglePassword() {
            const field = document.getElementById('passwordField');
            const icon = document.getElementById('eyeIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        updateIntervalDisplay();
        updateDurationDisplay();
        window.addEventListener('beforeunload', () => {
            if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
        });
    </script>
}
