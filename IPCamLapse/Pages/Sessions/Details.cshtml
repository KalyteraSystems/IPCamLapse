@page "{id}"
@model IPCamLapse.Pages.Sessions.DetailsModel
@using IPCamLapse.Models
@{
    ViewData["Title"] = Model.Session?.Name ?? "Session";
}

@if (Model.Session is null)
{
    <div class="alert alert-danger">Session not found.</div>
    <a asp-page="/Index" class="btn btn-primary">Back to sessions</a>
    return;
}

<header class="page-header">
    <div class="page-header-copy">
        <span class="page-kicker">Capture session / live workspace</span>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <h1 class="page-title">@Model.Session.Name</h1>
            <span class="badge @GetStatusBadgeClass(Model.Session.Status)" id="status-badge">@Model.Session.Status</span>
        </div>
        <p class="page-lede">@Model.CameraName · @FormatBytes(Model.SessionBytes) captured</p>
    </div>
    <div class="page-actions" id="session-actions">
        @if (Model.Session.Status is SessionStatus.Ready or SessionStatus.Paused or SessionStatus.Failed)
        {
            <button type="button" class="btn btn-success" onclick="runSessionAction('start', event)"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start</button>
        }
        @if (Model.Session.Status is SessionStatus.Capturing or SessionStatus.Scheduled or SessionStatus.Rendering)
        {
            <button type="button" class="btn btn-warning" onclick="runSessionAction('pause', event)"><i class="bi bi-pause-fill me-1" aria-hidden="true"></i>Pause</button>
        }
        @if (Model.Session.Status is SessionStatus.Capturing or SessionStatus.Paused or SessionStatus.Scheduled)
        {
            <button type="button" class="btn btn-outline-danger" onclick="cancelSession()"><i class="bi bi-stop-fill me-1" aria-hidden="true"></i>Cancel</button>
        }
        @if (Model.Session.VideoPath is not null || Model.Session.HasPartialVideo)
        {
            <a href="/api/sessions/@Model.Session.Id/video" download class="btn btn-primary"><i class="bi bi-download me-1" aria-hidden="true"></i>Download video</a>
        }
        <button type="button" class="btn btn-outline-danger" onclick="deleteSession()" aria-label="Delete session"><i class="bi bi-trash" aria-hidden="true"></i></button>
    </div>
</header>

@if (Model.Session.Status == SessionStatus.Rendering)
{
    <div class="alert alert-info d-flex align-items-center gap-3">
        <span class="spinner-border spinner-border-sm"></span>
        <span>Rendering video…</span>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Session.ErrorMessage))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.Session.ErrorMessage</div>
}

<section class="card shadow-sm mb-4 capture-progress-card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0"><span class="form-section-number">LIVE</span>Capture progress</h2>
            <strong id="progress-label">@Model.Session.GetProgressPercent(DateTime.UtcNow).ToString("F1")%</strong>
        </div>
        <div class="progress mb-3" style="height: 12px;">
            <div class="progress-bar @(Model.Session.Status == SessionStatus.Capturing ? "progress-bar-striped progress-bar-animated" : "")"
                 id="main-progress"
                 style="width: @FormatPercent(Model.Session.GetProgressPercent(DateTime.UtcNow))%"
                 role="progressbar"
                 aria-valuenow="@FormatPercent(Model.Session.GetProgressPercent(DateTime.UtcNow))"
                 aria-valuemin="0"
                 aria-valuemax="100"></div>
        </div>
        <div class="row g-3 session-stats">
            <div class="col-6 col-md-3"><span class="text-muted">Frames</span><strong id="frames-captured">@Model.Session.CapturedFrameCount</strong></div>
            <div class="col-6 col-md-3"><span class="text-muted">Active time</span><strong id="active-time">@FormatDuration(Model.Session.GetActiveCaptureSeconds(DateTime.UtcNow))</strong></div>
            <div class="col-6 col-md-3">
                <span class="text-muted">@(Model.Session.Status is SessionStatus.Completed or SessionStatus.Failed or SessionStatus.Cancelled ? "Finished" : "Next frame")</span>
                <strong id="next-capture">@(Model.Session.Status is SessionStatus.Completed or SessionStatus.Failed or SessionStatus.Cancelled
                    ? Model.Session.CompletedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—"
                    : Model.Session.NextCaptureAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</strong>
            </div>
            <div class="col-6 col-md-3"><span class="text-muted">Failures</span><strong id="failure-count" class="@(Model.Session.ConsecutiveCaptureFailures > 0 ? "text-danger" : "")">@Model.Session.ConsecutiveCaptureFailures consecutive</strong></div>
        </div>
        @if (Model.Session.Status == SessionStatus.Scheduled && Model.Session.ScheduledFor.HasValue)
        {
            <p class="small text-muted mt-3 mb-0"><i class="bi bi-calendar-event me-1"></i>Next window: @Model.Session.ScheduledFor.Value.ToLocalTime().ToString("f")</p>
        }
        <div class="small text-danger mt-3 @(string.IsNullOrWhiteSpace(Model.Session.LastCaptureError) ? "d-none" : "")" id="capture-diagnostic">@Model.Session.LastCaptureError</div>
    </div>
</section>

<div class="row g-4">
    <div class="col-xl-8">
        <section class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Latest frame</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshPreview()" aria-label="Refresh latest frame"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
            </div>
            <div class="card-body p-2 preview-stage">
                @if (Model.HasPreview)
                {
                    <img src="/api/sessions/@Model.Session.Id/preview?t=@DateTime.UtcNow.Ticks" id="preview-img" alt="Latest captured frame" class="img-fluid w-100" />
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="no-preview"><i class="bi bi-camera display-3"></i><p class="mt-2 mb-0">Waiting for the first frame</p></div>
                    <img id="preview-img" src="" alt="Latest captured frame" class="img-fluid w-100 d-none" />
                }
            </div>
        </section>

        @if (Model.Session.VideoPath is not null || Model.Session.HasPartialVideo)
        {
            <section class="card shadow-sm mb-4" id="video-section">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Video</h2>
                    <a href="/api/sessions/@Model.Session.Id/video" download class="btn btn-sm btn-primary"><i class="bi bi-download me-1"></i>Download</a>
                </div>
                <div class="card-body p-2">
                    <video id="video-player" controls preload="metadata" class="w-100">
                        <source src="/api/sessions/@Model.Session.Id/video?t=@DateTime.UtcNow.Ticks" type="video/mp4" />
                    </video>
                </div>
            </section>
        }

        <section class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Timeline</h2>
                <span class="badge bg-light text-dark" id="gallery-count">@Model.Frames.Total frames</span>
            </div>
            <div class="card-body">
                @if (Model.Frames.Total == 0)
                {
                    <div class="text-center text-muted py-4" id="empty-gallery">Captured frames will appear here.</div>
                }
                <div class="frame-gallery" id="frame-gallery">
                    @foreach (var frame in Model.Frames.Items)
                    {
                        <article class="frame-card">
                            <a href="@frame.PreviewUrl" target="_blank" rel="noopener">
                                <img src="@frame.PreviewUrl" alt="Frame @frame.Number captured @frame.CapturedAt.ToLocalTime().ToString("g")" loading="lazy" />
                            </a>
                            <div class="frame-meta">
                                <span>#@frame.Number · @frame.CapturedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                <a href="@frame.DownloadUrl" aria-label="Download frame @frame.Number"><i class="bi bi-download"></i></a>
                            </div>
                        </article>
                    }
                </div>
                @if (Model.Frames.Items.Count < Model.Frames.Total)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-3" id="load-more" onclick="loadMoreFrames()">Load more</button>
                }
            </div>
        </section>

        @if (Model.Frames.Total >= 2)
        {
            <section class="card shadow-sm mb-4">
                <div class="card-header"><h2 class="h5 mb-0">Render video</h2></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-sm-3">
                            <label class="form-label" for="range-start">First frame</label>
                            <input id="range-start" type="number" class="form-control" min="1" max="@Model.Session.CapturedFrameCount" value="@(Model.Session.RenderRangeStart ?? 1)" />
                        </div>
                        <div class="col-6 col-sm-3">
                            <label class="form-label" for="range-end">Last frame</label>
                            <input id="range-end" type="number" class="form-control" min="1" max="@Model.Session.CapturedFrameCount" value="@(Model.Session.RenderRangeEnd ?? Model.Session.CapturedFrameCount)" />
                        </div>
                        <div class="col-6 col-sm-3">
                            <label class="form-label" for="video-width">Width</label>
                            <input id="video-width" type="number" class="form-control" min="320" max="3840" step="2" value="@Model.Session.Configuration.Video.Width" />
                        </div>
                        <div class="col-6 col-sm-3">
                            <label class="form-label" for="video-height">Height</label>
                            <input id="video-height" type="number" class="form-control" min="240" max="2160" step="2" value="@Model.Session.Configuration.Video.Height" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="fit-mode">Fit</label>
                            <select id="fit-mode" class="form-select">
                                @foreach (var fitMode in Enum.GetValues<VideoFitMode>())
                                {
                                    <option value="@fitMode" selected="@(fitMode == Model.Session.Configuration.Video.FitMode)">@fitMode</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="frame-rate">Frame rate</label>
                            <input id="frame-rate" type="number" class="form-control" min="0" max="60" value="@Model.Session.Configuration.Video.FrameRate" />
                            <div class="form-text">0 chooses automatically.</div>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="video-quality">Quality (CRF)</label>
                            <input id="video-quality" type="number" class="form-control" min="18" max="35" value="@Model.Session.Configuration.Video.QualityCrf" />
                            <div class="form-text">Lower is higher quality.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input id="timestamp-overlay" type="checkbox" class="form-check-input" checked="@Model.Session.Configuration.Video.TimestampOverlay" />
                                <label class="form-check-label" for="timestamp-overlay">Add elapsed-time overlay</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mt-4">
                        <button type="button" class="btn btn-primary" id="render-button" onclick="renderVideo(event)" @(Model.Session.Status is SessionStatus.Capturing or SessionStatus.Scheduled or SessionStatus.Rendering ? "disabled" : null)>
                            <i class="bi bi-film me-1"></i>@(Model.Session.VideoPath is null ? "Render" : "Regenerate")
                        </button>
                        <span class="small" id="render-result" role="status"></span>
                    </div>
                </div>
            </section>
        }
    </div>

    <div class="col-xl-4 session-side-rail">
        <section class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Session details</h2></div>
            <div class="card-body">
                <dl class="row small mb-0 detail-list">
                    <dt class="col-5">Camera</dt><dd class="col-7">@Model.CameraName</dd>
                    <dt class="col-5">Interval</dt><dd class="col-7">@FormatDuration(Model.Session.Configuration.CaptureIntervalSeconds)</dd>
                    <dt class="col-5">Capture time</dt><dd class="col-7">@FormatDuration(Model.Session.Configuration.CaptureDurationSeconds)</dd>
                    <dt class="col-5">Video target</dt><dd class="col-7">@Model.Session.Configuration.VideoTargetDurationSeconds.ToString("0.#") s</dd>
                    <dt class="col-5">Schedule</dt><dd class="col-7">@FormatSchedule(Model.Session.Configuration.Schedule)</dd>
                    <dt class="col-5">Retries</dt><dd class="col-7">@Model.Session.Configuration.MaxCaptureRetries</dd>
                    <dt class="col-5">Failure limit</dt><dd class="col-7">@Model.Session.Configuration.MaxConsecutiveFailures consecutive</dd>
                    <dt class="col-5">Created</dt><dd class="col-7">@Model.Session.CreatedAt.ToLocalTime().ToString("g")</dd>
                    @if (Model.Session.CompletedAt.HasValue)
                    {
                        <dt class="col-5">Finished</dt><dd class="col-7">@Model.Session.CompletedAt.Value.ToLocalTime().ToString("g")</dd>
                    }
                </dl>
            </div>
        </section>

        <section class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Activity</h2></div>
            <div class="card-body">
                @if (Model.Events.Count == 0)
                {
                    <p class="small text-muted mb-0">No activity yet.</p>
                }
                else
                {
                    <div class="event-timeline" id="event-timeline">
                        @foreach (var captureEvent in Model.Events)
                        {
                            <div class="event-item @captureEvent.Kind.ToString().ToLowerInvariant()">
                                <span class="event-dot"></span>
                                <div>
                                    <strong>@FormatEvent(captureEvent)</strong>
                                    <time>@captureEvent.At.ToLocalTime().ToString("g")</time>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const sessionId = '@Model.Session.Id';
        let galleryOffset = @Model.Frames.Items.Count;
        let pollTimer = null;

        async function api(path, options = {}) {
            const response = await window.ipCamLapseFetch(path, options);
            if (response.ok) return response;
            let message = 'Action failed';
            try {
                const data = await response.json();
                message = data.message || data.detail || data.title || message;
            } catch { }
            throw new Error(message);
        }

        async function runSessionAction(action, event) {
            const button = event.target.closest('button');
            button.disabled = true;
            try {
                await api(`/api/sessions/${sessionId}/${action}`, { method: 'POST' });
                location.reload();
            } catch (error) {
                window.ipCamLapseNotify(error.message);
                button.disabled = false;
            }
        }

        async function cancelSession() {
            if (!confirm('Cancel this session? Captured frames will be kept.')) return;
            try {
                await api(`/api/sessions/${sessionId}/cancel`, { method: 'POST' });
                location.reload();
            } catch (error) { window.ipCamLapseNotify(error.message); }
        }

        async function deleteSession() {
            if (!confirm('Delete this session and all captured files?')) return;
            try {
                await api(`/api/sessions/${sessionId}`, { method: 'DELETE' });
                location.href = '/';
            } catch (error) { window.ipCamLapseNotify(error.message); }
        }

        async function renderVideo(event) {
            const button = event.target.closest('button');
            const result = document.getElementById('render-result');
            const start = parseInt(document.getElementById('range-start').value);
            const end = parseInt(document.getElementById('range-end').value);
            if (start > end) {
                result.className = 'small text-danger';
                result.textContent = 'First frame must come before last frame.';
                return;
            }
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Rendering…';
            result.className = 'small text-muted';
            result.textContent = 'This can take a moment.';
            try {
                await api(`/api/sessions/${sessionId}/render`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        startFrame: start,
                        endFrame: end,
                        settings: {
                            width: parseInt(document.getElementById('video-width').value),
                            height: parseInt(document.getElementById('video-height').value),
                            fitMode: document.getElementById('fit-mode').selectedIndex,
                            frameRate: parseInt(document.getElementById('frame-rate').value),
                            qualityCrf: parseInt(document.getElementById('video-quality').value),
                            timestampOverlay: document.getElementById('timestamp-overlay').checked
                        }
                    })
                });
                result.className = 'small text-success';
                result.textContent = 'Video ready.';
                location.reload();
            } catch (error) {
                result.className = 'small text-danger';
                result.textContent = error.message;
                button.disabled = false;
                button.innerHTML = '<i class="bi bi-film me-1"></i>Render';
            }
        }

        function refreshPreview() {
            const image = document.getElementById('preview-img');
            if (!image) return;
            const next = `/api/sessions/${sessionId}/preview?t=${Date.now()}`;
            const probe = new Image();
            probe.onload = () => {
                image.src = next;
                image.classList.remove('d-none');
                document.getElementById('no-preview')?.classList.add('d-none');
            };
            probe.src = next;
        }

        async function loadMoreFrames() {
            const button = document.getElementById('load-more');
            button.disabled = true;
            try {
                const response = await fetch(`/api/sessions/${sessionId}/frames?offset=${galleryOffset}&limit=24`);
                const page = await response.json();
                page.items.forEach(addFrame);
                galleryOffset += page.items.length;
                if (galleryOffset >= page.total) button.remove();
                else button.disabled = false;
            } catch {
                button.disabled = false;
            }
        }

        function addFrame(frame) {
            const article = document.createElement('article');
            article.className = 'frame-card';
            const link = document.createElement('a');
            link.href = frame.previewUrl;
            link.target = '_blank';
            link.rel = 'noopener';
            const image = document.createElement('img');
            image.src = frame.previewUrl;
            image.alt = `Frame ${frame.number}`;
            image.loading = 'lazy';
            link.appendChild(image);
            const meta = document.createElement('div');
            meta.className = 'frame-meta';
            const label = document.createElement('span');
            label.textContent = `#${frame.number} · ${new Date(frame.capturedAt).toLocaleTimeString()}`;
            const download = document.createElement('a');
            download.href = frame.downloadUrl;
            download.ariaLabel = `Download frame ${frame.number}`;
            download.innerHTML = '<i class="bi bi-download"></i>';
            meta.append(label, download);
            article.append(link, meta);
            document.getElementById('frame-gallery').appendChild(article);
        }

        function updateStatus(data) {
            if (data.sessionId === sessionId) location.reload();
        }

        function updateProgress(data) {
            if (data.sessionId !== sessionId) return;
            const percent = data.progressPercent.toFixed(1);
            document.getElementById('main-progress').style.width = percent + '%';
            document.getElementById('main-progress').setAttribute('aria-valuenow', percent);
            document.getElementById('progress-label').textContent = percent + '%';
            document.getElementById('frames-captured').textContent = data.frameCount;
            if (data.nextCaptureAt) document.getElementById('next-capture').textContent = new Date(data.nextCaptureAt).toLocaleTimeString();
            refreshPreview();
        }

        async function pollStatus() {
            try {
                const response = await fetch(`/api/sessions/${sessionId}/status`);
                if (!response.ok) return;
                const data = await response.json();
                const percent = data.progressPercent.toFixed(1);
                document.getElementById('main-progress').style.width = percent + '%';
                document.getElementById('progress-label').textContent = percent + '%';
                document.getElementById('frames-captured').textContent = data.capturedFrameCount;
                document.getElementById('active-time').textContent = formatSeconds(data.activeCaptureSeconds);
                document.getElementById('failure-count').textContent = `${data.consecutiveFailures} consecutive`;
                if (data.lastError) {
                    const diagnostic = document.getElementById('capture-diagnostic');
                    diagnostic.textContent = data.lastError;
                    diagnostic.classList.remove('d-none');
                }
                if (!['Capturing', 'Scheduled'].includes(data.status)) {
                    clearInterval(pollTimer);
                    location.reload();
                }
            } catch { }
        }

        function formatSeconds(seconds) {
            seconds = Math.max(0, Math.floor(seconds));
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const remainder = seconds % 60;
            return hours ? `${hours}h ${minutes}m` : minutes ? `${minutes}m ${remainder}s` : `${remainder}s`;
        }

        const connection = new signalR.HubConnectionBuilder().withUrl('/progressHub').withAutomaticReconnect().build();
        connection.on('ProgressUpdate', updateProgress);
        connection.on('StatusChanged', updateStatus);
        connection.on('SessionCompleted', updateStatus);
        connection.on('CaptureDiagnostic', data => {
            if (data.sessionId !== sessionId) return;
            const diagnostic = document.getElementById('capture-diagnostic');
            diagnostic.textContent = data.error || 'Camera capture failed.';
            diagnostic.classList.remove('d-none');
            document.getElementById('failure-count').textContent = `${data.consecutiveFailures} consecutive`;
        });

        async function connect() {
            try {
                await connection.start();
                await connection.invoke('JoinSession', sessionId);
            } catch { }
        }

        @if (Model.Session.Status is SessionStatus.Capturing or SessionStatus.Scheduled)
        {
            <text>
            connect();
            pollTimer = setInterval(pollStatus, 5000);
            </text>
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(SessionStatus status) => status switch
    {
        SessionStatus.Capturing => "bg-success",
        SessionStatus.Paused => "bg-warning text-dark",
        SessionStatus.Completed => "bg-primary",
        SessionStatus.Failed => "bg-danger",
        SessionStatus.Cancelled => "bg-secondary",
        SessionStatus.Scheduled => "bg-info text-dark",
        SessionStatus.Rendering => "bg-info text-dark",
        _ => "bg-light text-dark"
    };

    string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024) return $"{bytes / 1024d / 1024d / 1024d:F1} GB";
        if (bytes >= 1024L * 1024) return $"{bytes / 1024d / 1024d:F1} MB";
        return $"{bytes / 1024d:F0} KB";
    }

    string FormatPercent(double value) => value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    string FormatDuration(double seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        if (span.TotalMinutes >= 1) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{span.Seconds}s";
    }

    string FormatSchedule(CaptureSchedule schedule) => schedule.Frequency switch
    {
        ScheduleFrequency.Once when schedule.StartAtUtc.HasValue => $"Once · {schedule.StartAtUtc.Value.ToLocalTime():g}",
        ScheduleFrequency.Daily => $"Daily · {schedule.WindowStartLocal:hh\\:mm}–{schedule.WindowEndLocal:hh\\:mm}",
        ScheduleFrequency.Weekly => $"{schedule.WeeklyDay} · {schedule.WindowStartLocal:hh\\:mm}–{schedule.WindowEndLocal:hh\\:mm}",
        _ => "Continuous"
    };

    string FormatEvent(CaptureEvent captureEvent) => captureEvent.Kind switch
    {
        CaptureEventKind.Frame => $"Frame #{captureEvent.FrameNumber}",
        CaptureEventKind.Failure => captureEvent.Message ?? "Capture failed",
        _ => captureEvent.Message ?? "State changed"
    };
}
