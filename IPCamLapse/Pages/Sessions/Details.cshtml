@page "{id}"
@model IPCamLapse.Pages.Sessions.DetailsModel
@{
    ViewData["Title"] = Model.Session?.Name ?? "Session Details";
}

@if (Model.Session == null)
{
    <div class="alert alert-danger">Session not found.</div>
    <a asp-page="/Index" class="btn btn-primary">Back to Dashboard</a>
    return;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
            <li class="breadcrumb-item active">@Model.Session.Name</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="h2 mb-1">@Model.Session.Name</h1>
            <span class="badge @GetStatusBadgeClass(Model.Session.Status) fs-6" id="status-badge">
                @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span id="status-text">@Model.Session.Status</span>
            </span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Created || Model.Session.Status == IPCamLapse.Models.SessionStatus.Paused)
            {
                <button class="btn btn-success btn-lg" onclick="startSession()">
                    <i class="bi bi-play-fill me-2"></i>Start
                </button>
            }
            @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running)
            {
                <button class="btn btn-warning btn-lg" onclick="stopSession()">
                    <i class="bi bi-pause-fill me-2"></i>Pause
                </button>
                <button class="btn btn-outline-info" onclick="generatePartialVideo()" id="partial-video-btn">
                    <i class="bi bi-film me-2"></i>Generate Preview Video
                </button>
            }
            @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running || Model.Session.Status == IPCamLapse.Models.SessionStatus.Paused)
            {
                <button class="btn btn-outline-danger" onclick="cancelSession()">
                    <i class="bi bi-stop-fill me-2"></i>Cancel
                </button>
            }
            @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Completed || Model.Session.HasPartialVideo)
            {
                <a href="/api/sessions/@Model.Session.Id/video" download class="btn btn-primary btn-lg">
                    <i class="bi bi-download me-2"></i>Download Video
                </a>
            }
            <button class="btn btn-outline-danger" onclick="deleteSession()" title="Delete session">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Progress & Stats -->
    <div class="col-lg-8">
        <!-- Progress Card -->
        @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running || Model.Session.Status == IPCamLapse.Models.SessionStatus.Paused)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-activity me-2"></i>Progress</h5>
                        <span class="badge bg-info" id="remaining-time">
                            @if (Model.Session.RemainingTime.HasValue)
                            {
                                @FormatTimeSpan(Model.Session.RemainingTime.Value)<text> remaining</text>
                            }
                        </span>
                    </div>
                    <div class="progress mb-2" style="height: 20px;">
                        <div class="progress-bar progress-bar-striped @(Model.Session.Status == IPCamLapse.Models.SessionStatus.Running ? "progress-bar-animated" : "") bg-success"
                             id="main-progress"
                             style="width: @Model.Session.ProgressPercent.ToString("F1")%"
                             role="progressbar">
                            <span id="progress-label">@Model.Session.ProgressPercent.ToString("F1")%</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span id="frames-captured">@Model.Session.CapturedFrameCount / @Model.Session.ExpectedTotalFrames frames</span>
                        <span id="last-capture">
                            @if (Model.Session.LastCaptureAt.HasValue)
                            { <text>Last: @FormatTimeAgo(Model.Session.LastCaptureAt.Value)</text> }
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- Camera Preview -->
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-image me-2"></i>Latest Frame</h5>
                <div class="d-flex gap-2 align-items-center">
                    @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running)
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="autoRefresh" checked onchange="toggleAutoRefresh()">
                            <label class="form-check-label small" for="autoRefresh">Auto-refresh</label>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-secondary" onclick="refreshPreview()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-2">
                @if (Model.HasPreview)
                {
                    <img src="/api/sessions/@Model.Session.Id/preview?t=@DateTime.UtcNow.Ticks" 
                         id="preview-img" alt="Latest frame" 
                         class="img-fluid rounded w-100" style="max-height: 400px; object-fit: contain;" />
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="no-preview">
                        <i class="bi bi-camera display-3"></i>
                        <p class="mt-2">No frames captured yet</p>
                    </div>
                    <img id="preview-img" src="" alt="Latest frame" class="img-fluid rounded w-100 d-none" style="max-height: 400px; object-fit: contain;" />
                }
            </div>
            @if (Model.Session.LastCaptureAt.HasValue)
            {
                <div class="card-footer text-muted small" id="capture-timestamp">
                    <i class="bi bi-clock me-1"></i>Captured <span id="capture-time-ago">@FormatTimeAgo(Model.Session.LastCaptureAt.Value)</span>
                    at @Model.Session.LastCaptureAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                </div>
            }
        </div>

        <!-- Video Player -->
        <div class="card shadow-sm mb-4" id="video-section" 
             style="@(Model.Session.Status == IPCamLapse.Models.SessionStatus.Completed || Model.Session.HasPartialVideo ? "" : "display:none;")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-play-circle me-2"></i>Timelapse Video
                    @if (Model.Session.HasPartialVideo && Model.Session.Status != IPCamLapse.Models.SessionStatus.Completed)
                    {
                        <span class="badge bg-warning text-dark ms-2">Preview</span>
                    }
                </h5>
                <a href="/api/sessions/@Model.Session.Id/video" download class="btn btn-sm btn-primary">
                    <i class="bi bi-download me-1"></i>Download
                </a>
            </div>
            <div class="card-body p-2">
                <video id="video-player" controls class="w-100 rounded" style="max-height: 400px; background: #000;"
                       preload="metadata">
                    <source src="/api/sessions/@Model.Session.Id/video" type="video/mp4" id="video-source" />
                    Your browser does not support video playback.
                </video>
            </div>
        </div>
    </div>

    <!-- Info Panel -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Session Info</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-3">ID</td>
                            <td class="pe-3"><code>@Model.Session.Id</code></td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Preset</td>
                            <td class="pe-3">@Model.Session.Configuration.PresetName</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Camera</td>
                            <td class="pe-3 text-break small">@Model.Session.Configuration.CameraUrl</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Interval</td>
                            <td class="pe-3">@FormatDuration(Model.Session.Configuration.CaptureIntervalSeconds)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Total Duration</td>
                            <td class="pe-3">@FormatLongDuration(Model.Session.Configuration.CaptureDurationSeconds)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Target Video</td>
                            <td class="pe-3">@Model.Session.Configuration.VideoTargetDurationSeconds s</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Created</td>
                            <td class="pe-3 small">@Model.Session.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                        @if (Model.Session.StartedAt.HasValue)
                        {
                            <tr>
                                <td class="text-muted ps-3">Started</td>
                                <td class="pe-3 small">@Model.Session.StartedAt.Value.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                        @if (Model.Session.CompletedAt.HasValue)
                        {
                            <tr>
                                <td class="text-muted ps-3">Completed</td>
                                <td class="pe-3 small">@Model.Session.CompletedAt.Value.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                        <tr>
                            <td class="text-muted ps-3">Frames</td>
                            <td class="pe-3"><span id="info-frames">@Model.Session.CapturedFrameCount</span> / @Model.Session.ExpectedTotalFrames</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Session.ErrorMessage))
        {
            <div class="alert alert-danger">
                <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>Error</h6>
                <p class="mb-0 small">@Model.Session.ErrorMessage</p>
            </div>
        }

        <!-- Stats Card -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="fs-4 fw-bold text-primary" id="stat-frames">@Model.Session.CapturedFrameCount</div>
                            <small class="text-muted">Frames</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="fs-4 fw-bold text-success" id="stat-progress">@Model.Session.ProgressPercent.ToString("F0")%</div>
                            <small class="text-muted">Progress</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="fs-4 fw-bold text-info">@FormatDurationShort(Model.Session.Configuration.CaptureIntervalSeconds)</div>
                            <small class="text-muted">Interval</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light">
                            <div class="fs-4 fw-bold text-warning">@Model.Session.Configuration.VideoTargetDurationSeconds<small>s</small></div>
                            <small class="text-muted">Video</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const sessionId = '@Model.Session.Id';
        let autoRefreshInterval = null;
        let previewInterval = null;

        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/progressHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ProgressUpdate", (data) => {
            if (data.sessionId !== sessionId) return;
            updateProgress(data.progressPercent, data.frameCount, data.lastCaptureAt);
        });

        connection.on("SessionCompleted", (data) => {
            if (data.sessionId !== sessionId) return;
            updateStatusBadge('Completed', 'bg-primary');
            if (data.hasVideo) {
                document.getElementById('video-section').style.display = '';
                const video = document.getElementById('video-player');
                video.load();
            }
            stopAutoRefresh();
            setTimeout(() => location.reload(), 2000);
        });

        async function startSignalR() {
            try {
                await connection.start();
                await connection.invoke("JoinSession", sessionId);
            } catch (err) {
                console.error("SignalR failed:", err);
                // Fallback to polling
                startPolling();
            }
        }

        function startPolling() {
            if (autoRefreshInterval) return;
            autoRefreshInterval = setInterval(pollStatus, 10000);
        }

        async function pollStatus() {
            try {
                const r = await fetch(`/api/sessions/${sessionId}/status`);
                if (!r.ok) return;
                const data = await r.json();
                updateProgress(data.progressPercent, data.capturedFrameCount, data.lastCaptureAt);
                if (data.status === 'Completed') {
                    clearInterval(autoRefreshInterval);
                    location.reload();
                }
            } catch { /* ignore */ }
        }

        function updateProgress(percent, frames, lastCapture) {
            const progressBar = document.getElementById('main-progress');
            const progressLabel = document.getElementById('progress-label');
            const framesEl = document.getElementById('frames-captured');
            const statFrames = document.getElementById('stat-frames');
            const statProgress = document.getElementById('stat-progress');
            const infoFrames = document.getElementById('info-frames');

            if (progressBar) {
                progressBar.style.width = percent.toFixed(1) + '%';
                progressLabel.textContent = percent.toFixed(1) + '%';
            }
            const expectedFrames = @Model.Session.ExpectedTotalFrames;
            if (framesEl) framesEl.textContent = `${frames} / ${expectedFrames} frames`;
            if (statFrames) statFrames.textContent = frames;
            if (statProgress) statProgress.textContent = percent.toFixed(0) + '%';
            if (infoFrames) infoFrames.textContent = frames;

            if (lastCapture) {
                const captureTime = document.getElementById('capture-time-ago');
                if (captureTime) {
                    const date = new Date(lastCapture);
                    const diff = (Date.now() - date.getTime()) / 1000;
                    captureTime.textContent = formatTimeAgo(diff);
                }
            }
        }

        function updateStatusBadge(status, badgeClass) {
            const badge = document.getElementById('status-badge');
            const statusText = document.getElementById('status-text');
            if (badge) badge.className = `badge ${badgeClass} fs-6`;
            if (statusText) statusText.textContent = status;
        }

        function formatTimeAgo(seconds) {
            if (seconds < 60) return `${Math.floor(seconds)}s ago`;
            if (seconds < 3600) return `${Math.floor(seconds/60)}m ago`;
            return `${Math.floor(seconds/3600)}h ago`;
        }

        // Preview auto-refresh
        function toggleAutoRefresh() {
            const checked = document.getElementById('autoRefresh').checked;
            if (checked) startPreviewRefresh();
            else stopPreviewRefresh();
        }

        function startPreviewRefresh() {
            if (previewInterval) return;
            previewInterval = setInterval(refreshPreview, 30000);
        }

        function stopPreviewRefresh() {
            if (previewInterval) { clearInterval(previewInterval); previewInterval = null; }
        }

        function stopAutoRefresh() {
            stopPreviewRefresh();
            if (autoRefreshInterval) { clearInterval(autoRefreshInterval); autoRefreshInterval = null; }
        }

        function refreshPreview() {
            const img = document.getElementById('preview-img');
            if (!img) return;
            const newSrc = `/api/sessions/${sessionId}/preview?t=${Date.now()}`;
            const tempImg = new Image();
            tempImg.onload = () => {
                img.src = newSrc;
                img.classList.remove('d-none');
                const noPreview = document.getElementById('no-preview');
                if (noPreview) noPreview.classList.add('d-none');
            };
            tempImg.src = newSrc;
        }

        async function startSession() {
            const btn = event.target.closest('button');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Starting...';
            try {
                const r = await fetch(`/api/sessions/${sessionId}/start`, { method: 'POST' });
                if (r.ok) location.reload();
                else { const err = await r.json(); alert(err.message || 'Failed to start'); btn.disabled = false; }
            } catch { alert('Error starting session'); btn.disabled = false; }
        }

        async function stopSession() {
            const btn = event.target.closest('button');
            btn.disabled = true;
            try {
                await fetch(`/api/sessions/${sessionId}/stop`, { method: 'POST' });
                location.reload();
            } finally { btn.disabled = false; }
        }

        async function cancelSession() {
            if (!confirm('Are you sure you want to cancel this session? This cannot be undone.')) return;
            try {
                await fetch(`/api/sessions/${sessionId}/cancel`, { method: 'POST' });
                location.reload();
            } catch { alert('Error cancelling session'); }
        }

        async function deleteSession() {
            if (!confirm('Delete this session and all captured data? This cannot be undone.')) return;
            try {
                const r = await fetch(`/api/sessions/${sessionId}`, { method: 'DELETE' });
                if (r.ok) window.location.href = '/';
                else alert('Failed to delete session');
            } catch { alert('Error deleting session'); }
        }

        async function generatePartialVideo() {
            const btn = document.getElementById('partial-video-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generating...';
            try {
                const r = await fetch(`/api/sessions/${sessionId}/generate-partial-video`, { method: 'POST' });
                if (r.ok) {
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Video Ready!';
                    btn.className = 'btn btn-success';
                    document.getElementById('video-section').style.display = '';
                    const video = document.getElementById('video-player');
                    video.load();
                    setTimeout(() => {
                        btn.innerHTML = '<i class="bi bi-film me-2"></i>Generate Preview Video';
                        btn.className = 'btn btn-outline-info';
                        btn.disabled = false;
                    }, 3000);
                } else {
                    const err = await r.json();
                    alert(err.detail || err.title || 'Failed to generate video');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-film me-2"></i>Generate Preview Video';
                }
            } catch {
                alert('Error generating video');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-film me-2"></i>Generate Preview Video';
            }
        }

        // Initialize
        @if (Model.Session.Status == IPCamLapse.Models.SessionStatus.Running)
        {
            <text>
            startSignalR();
            startPreviewRefresh();
            </text>
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(IPCamLapse.Models.SessionStatus status) => status switch
    {
        IPCamLapse.Models.SessionStatus.Running => "bg-success",
        IPCamLapse.Models.SessionStatus.Paused => "bg-warning text-dark",
        IPCamLapse.Models.SessionStatus.Completed => "bg-primary",
        IPCamLapse.Models.SessionStatus.Failed => "bg-danger",
        IPCamLapse.Models.SessionStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string FormatTimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        return $"{(int)diff.TotalHours}h ago";
    }

    string FormatTimeSpan(TimeSpan ts)
    {
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays}d {ts.Hours}h";
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
    }

    string FormatDuration(int seconds)
    {
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m {seconds % 60}s";
        return $"{seconds / 3600}h {(seconds % 3600) / 60}m";
    }

    string FormatDurationShort(int seconds)
    {
        if (seconds < 60) return $"{seconds}s";
        if (seconds < 3600) return $"{seconds / 60}m";
        return $"{seconds / 3600}h";
    }

    string FormatLongDuration(long seconds)
    {
        if (seconds < 3600) return $"{seconds / 60} min";
        if (seconds < 86400) return $"{seconds / 3600} hours";
        if (seconds < 604800) return $"{seconds / 86400} days";
        if (seconds < 2592000) return $"{seconds / 604800} weeks";
        if (seconds < 31536000) return $"{seconds / 2592000} months";
        return $"{seconds / 31536000} years";
    }
}
